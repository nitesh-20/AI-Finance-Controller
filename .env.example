# AI Finance Controller - Root Environment Configuration Template
# Copy this file to .env and insert your secure API keys

# Google Gemini API Key (for Live Voice Copilot)
GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Backend FastAPI Configuration
PORT=8000
HOST=0.0.0.0
ENV=development

# LiveKit & Voice Sidecar (Optional for WebRTC Sidecar)
LIVEKIT_URL=your_livekit_url_here
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here
DEEPGRAM_API_KEY=your_deepgram_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
